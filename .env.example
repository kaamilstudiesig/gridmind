# ==============================================================================
# GridMind Environment Configuration
# ==============================================================================

# LLM Narrative Generation Credentials
# GridMind uses OpenAI/OpenRouter-compatible chat completions for specialist narrative synthesis.
# If no key is provided, GridMind operates seamlessly in deterministic [DEGRADED_MODE].
OPENROUTER_API_KEY=
OPENAI_API_KEY=
TRUEFORGE_API_KEY=

# LLM Endpoint & Model Configuration
# Base URL for the OpenAI-compatible endpoint (defaults to OpenRouter if unset)
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model identifier for specialist findings and recommendation text synthesis
LLM_MODEL=openrouter/free

# Dashboard & API Authentication
# Optional custom JSON token-to-user mapping for operator Bearer token authentication.
# Defaults to built-in development tokens (operator_alice, operator_bob, viewer_charlie) if unset.
# GRIDMIND_AUTH_TOKENS='{"gm-lead-token-secret":{"username":"operator_alice","role":"operator_lead","roles":["viewer","operator","operator_lead","admin"]}}'

# Server & Network Configuration
# Host IP to bind server processes (default: 127.0.0.1)
HOST=127.0.0.1
# Port to listen on (8000 for MCP HTTP server, 8080 for Command Center Dashboard)
PORT=8000
# Enable debug logging (true/false)
DEBUG=false
