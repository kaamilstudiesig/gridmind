# ==============================================================================
# GridMind Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Options (Choose ONE provider or leave blank for [DEGRADED_MODE])
# ------------------------------------------------------------------------------

# Option A: OpenRouter (Default)
# Automatically uses LLM_BASE_URL=https://openrouter.ai/api/v1 and LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free

# Option B: OpenAI Direct
# When set without OPENROUTER_API_KEY, automatically defaults to OpenAI endpoint and model:
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Option C: TrueForge LLM Proxy
# When TRUEFORGE_API_KEY is used, you MUST supply an explicit proxy LLM_BASE_URL:
# TRUEFORGE_API_KEY=tf-...
# LLM_BASE_URL=https://your-trueforge-llm-proxy.com/v1
# LLM_MODEL=default

# ------------------------------------------------------------------------------
# 2. Dashboard & API Authentication (RBAC)
# ------------------------------------------------------------------------------
# Optional custom JSON token-to-user mapping for operator Bearer token authentication.
# Defaults to built-in development tokens (operator_alice, operator_bob, viewer_charlie) if unset.
# GRIDMIND_AUTH_TOKENS='{"gm-lead-token-secret":{"username":"operator_alice","role":"operator_lead","roles":["viewer","operator","operator_lead","admin"]}}'

# ------------------------------------------------------------------------------
# 3. Unified Server & Network Configuration
# ------------------------------------------------------------------------------
# Host interface to bind to (default: 127.0.0.1)
HOST=127.0.0.1
# Port to listen on (default: 8080 for unified server hosting Dashboard + MCP + Health)
PORT=8080
# Optional port overrides when running specific CLI components:
# DASHBOARD_PORT=8080
# MCP_PORT=8000
# Enable debug logging (true/false)
DEBUG=false
